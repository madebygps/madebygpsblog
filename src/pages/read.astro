---
import BaseLayout from '../layouts/BaseLayout.astro';

type Book = { title: string; author: string; href: string; coverId: number; spineAuthor?: string };

const shelves: { name: string; books: Book[] }[] = [
  {
    name: 'Understanding the Impact of Tech',
    books: [
      { title: 'Recoding America', author: 'Jennifer Pahlka', coverId: 14400207, href: 'https://www.recodingamerica.us/' },
      { title: 'The Coming Wave', author: 'Mustafa Suleyman', coverId: 14421031, href: 'https://www.the-coming-wave.com/' },
      { title: 'Tools and Weapons', author: 'Brad Smith', coverId: 8780415, href: 'https://www.penguinrandomhouse.com/books/604709/tools-and-weapons-by-brad-smith-and-carol-ann-browne/' },
      { title: 'Burn Book', author: 'Kara Swisher', coverId: 14805245, href: 'https://www.pbsbooks.org/virtual-library/burn-book-a-tech-love-story/' },
    ],
  },
  {
    name: 'Improve my focus',
    books: [
      { title: 'Digital Minimalism', author: 'Cal Newport', coverId: 8507540, href: 'https://calnewport.com/my-new-book-digital-minimalism/' },
      { title: 'Stolen Focus', author: 'Johann Hari', coverId: 12664855, href: 'https://stolenfocusbook.com/' },
    ],
  },
  {
    name: 'Improve my discipline',
    books: [
      { title: 'Grit', author: 'Angela Duckworth', coverId: 7438753, href: 'https://angeladuckworth.com/grit-book/' },
      { title: 'Discipline Is Destiny', author: 'Ryan Holiday', coverId: 12996579, href: 'https://store.dailystoic.com/pages/discipline-is-destiny' },
    ],
  },
  {
    name: 'Improve my soul',
    books: [
      { title: 'Stillness Is the Key', author: 'Ryan Holiday', coverId: 9130310, href: 'https://dailystoic.com/stillness-is-the-key/' },
      { title: 'An Emotional Education', author: 'The School of Life', coverId: 10329695, spineAuthor: 'School of Life', href: 'https://www.theschooloflife.com/shop/an-emotional-education/' },
      { title: 'Together', author: 'Vivek Murthy', coverId: 9415465, href: 'https://www.vivekmurthy.com/together-book' },
      { title: 'The Daily Stoic', author: 'Ryan Holiday', coverId: 12685501, href: 'https://www.goodreads.com/book/show/29093292-the-daily-stoic' },
      { title: 'All About Love', author: 'bell hooks', coverId: 42317, href: 'https://bellhooksbooks.com/product/all-about-love/' },
    ],
  },
  {
    name: 'Get lost in other worlds',
    books: [
      { title: 'Stories of Your Life and Others', author: 'Ted Chiang', coverId: 524046, href: 'https://www.penguinrandomhouse.com/books/538163/stories-of-your-life-and-others-by-ted-chiang/' },
      { title: 'The Phoenix Project', author: 'Gene Kim', coverId: 9151976, href: 'https://itrevolution.com/product/the-phoenix-project/' },
      { title: 'Exhalation', author: 'Ted Chiang', coverId: 8793546, href: 'https://www.penguinrandomhouse.com/books/538034/exhalation-by-ted-chiang/' },
      { title: 'Babel', author: 'R. F. Kuang', coverId: 12866714, href: 'https://www.harpercollins.com/products/babel-r-f-kuang?variant=39874690940962' },
      { title: 'Project Hail Mary', author: 'Andy Weir', coverId: 11200092, href: 'https://www.penguinrandomhouse.com/books/611060/project-hail-mary-by-andy-weir/' },
      { title: 'The Mountain in the Sea', author: 'Ray Nayler', coverId: 14642507, href: 'https://tombolobooks.com/item/3Czr8TaWU9-EJk7ukwhFFw' },
      { title: 'Demon Copperhead', author: 'Barbara Kingsolver', coverId: 13141227, href: 'https://concordbookshop.com/book/9780063251984' },
    ],
  },
  {
    name: 'Improve my critical thinking skills',
    books: [
      { title: 'What’s Our Problem?', author: 'Tim Urban', coverId: 13323691, href: 'https://waitbutwhy.com/whatsourproblem' },
      { title: 'Why Fish Don’t Exist', author: 'Lulu Miller', coverId: 9423979, href: 'https://www.simonandschuster.com/books/Why-Fish-Dont-Exist/Lulu-Miller/9781501160349' },
    ],
  },
  {
    name: 'Improve my physical health',
    books: [
      { title: 'Why We Sleep', author: 'Matthew Walker', coverId: 8814155, href: 'https://www.simonandschuster.com/books/Why-We-Sleep/Matthew-Walker/9781501144325' },
      { title: 'The Body Keeps the Score', author: 'Bessel van der Kolk', coverId: 8315367, spineAuthor: 'van der Kolk', href: 'https://www.besselvanderkolk.com/resources/the-body-keeps-the-score' },
    ],
  },
  {
    name: 'Improve my mental health',
    books: [
      { title: 'The Boy Who Was Raised as a Dog', author: 'Bruce D. Perry', coverId: 12511114, href: 'https://www.hachettebookgroup.com/titles/bruce-d-perry/the-boy-who-was-raised-as-a-dog/9780465094455/?lens=basic-books' },
    ],
  },
  {
    name: 'Improve my financial status',
    books: [
      { title: 'I Will Teach You to Be Rich', author: 'Ramit Sethi', coverId: 6305971, href: 'https://www.iwillteachyoutoberich.com/books/' },
    ],
  },
  {
    name: 'Standing on the shoulders of giants',
    books: [
      { title: 'Personal History', author: 'Katharine Graham', coverId: 253955, href: 'https://www.penguinrandomhouse.com/books/70346/personal-history-by-katharine-graham/' },
      { title: 'Einstein', author: 'Walter Isaacson', coverId: 474440, href: 'https://www.simonandschuster.com/books/Einstein/Walter-Isaacson/9780743264747' },
      { title: 'Meditations', author: 'Marcus Aurelius', coverId: 211529, href: 'https://classics.mit.edu/Antoninus/meditations.html' },
      { title: 'Lives of the Stoics', author: 'Ryan Holiday', coverId: 10491929, href: 'https://www.penguinrandomhouse.com/books/605841/lives-of-the-stoics-by-ryan-holiday-and-stephen-hanselman/' },
      { title: 'Leonardo da Vinci', author: 'Walter Isaacson', coverId: 8087691, href: 'https://www.simonandschuster.com/books/Leonardo-da-Vinci/Walter-Isaacson/9781501139161' },
      { title: 'The Last Days of the Incas', author: 'Kim MacQuarrie', coverId: 474243, href: 'https://www.simonandschuster.com/books/The-Last-Days-of-the-Incas/Kim-MacQuarrie/9780743260503' },
    ],
  },
];

const total = shelves.reduce((sum, shelf) => sum + shelf.books.length, 0);

// Spread spine colors and sizes across the whole shelf so neighbors differ.
const spineCount = 6;
const heights = ['13.5rem', '12rem', '14.5rem', '12.75rem', '13.75rem'];
const widths = ['3rem', '2.6rem', '3.3rem', '2.8rem'];
let index = 0;
const placed = shelves.map((shelf) => ({
  ...shelf,
  books: shelf.books.map((book) => {
    const i = index++;
    return {
      ...book,
      number: String(i + 1).padStart(2, '0'),
      tone: (i * 5) % spineCount,
      style: `--spine-h: ${heights[i % heights.length]}; --spine-w: ${widths[(i * 3) % widths.length]};`,
    };
  }),
}));
---

<BaseLayout
  title="Books | madebygps"
  description="A shelf of books that helped me learn, grow, and become a better person. An ongoing list."
  lang="en"
  wide
>
  <section class="page-head">
    <p class="eyebrow">{total} books</p>
    <h1>Books</h1>
    <p class="lede">
      Books that expanded my life. Not only tech, because the best technologists are well rounded.
      This is an ongoing list that I update as I continue to read and live.
    </p>
    <p class="shelf-hint">Select a book to see its cover and link.</p>
  </section>

  {
    placed.map((shelf) => (
      <section class="shelf">
        <h2 class="shelf-label">{shelf.name}</h2>
        <ul class="shelf-row">
          {shelf.books.map((book) => (
            <li>
              <a
                class={`spine spine-tone-${book.tone}`}
                style={book.style}
                href={book.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${book.title} by ${book.author}`}
                aria-haspopup="dialog"
                data-title={book.title}
                data-author={book.author}
                data-cover-id={book.coverId}
              >
                <span class="spine-number" aria-hidden="true">{book.number}</span>
                <span class="spine-title" aria-hidden="true">{book.title}</span>
                <span class="spine-author" aria-hidden="true">{book.spineAuthor ?? book.author.split(' ').at(-1)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <p class="shelf-credit">Book covers from <a href="https://openlibrary.org/">Open Library</a>.</p>

  <dialog class="book-detail" aria-labelledby="book-detail-title">
    <button class="book-detail-close" type="button" aria-label="Close book details">×</button>
    <div class="book-detail-cover"></div>
    <p class="book-detail-unavailable" hidden>Cover unavailable.</p>
    <h2 id="book-detail-title"></h2>
    <p class="book-detail-author"></p>
    <a class="book-detail-link" target="_blank" rel="noopener noreferrer">Visit book page</a>
  </dialog>
</BaseLayout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.book-detail');
  const close = document.querySelector<HTMLButtonElement>('.book-detail-close');
  const title = document.querySelector<HTMLElement>('#book-detail-title');
  const author = document.querySelector<HTMLElement>('.book-detail-author');
  const link = document.querySelector<HTMLAnchorElement>('.book-detail-link');
  const cover = document.querySelector<HTMLElement>('.book-detail-cover');
  const unavailable = document.querySelector<HTMLElement>('.book-detail-unavailable');

  if (dialog && close && title && author && link && cover && unavailable) {
    let currentImage: HTMLImageElement;

    close.addEventListener('click', () => dialog.close());
    document.querySelectorAll<HTMLAnchorElement>('.spine').forEach((book) => {
      book.addEventListener('click', (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        const { title: bookTitle, author: bookAuthor, coverId } = book.dataset;
        if (!bookTitle || !bookAuthor || !coverId) return;

        event.preventDefault();
        title.textContent = bookTitle;
        author.textContent = bookAuthor;
        link.href = book.href;
        unavailable.hidden = true;

        const image = new Image();
        currentImage = image;
        image.alt = `Cover of ${bookTitle}`;
        image.addEventListener('error', () => {
          if (currentImage === image) unavailable.hidden = false;
        });
        cover.replaceChildren(image);
        image.src = `https://covers.openlibrary.org/b/id/${coverId}-M.jpg?default=false`;
        dialog.showModal();
      });
    });
  }
</script>

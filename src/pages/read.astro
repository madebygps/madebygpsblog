---
import BaseLayout from '../layouts/BaseLayout.astro';
import BooksContent from '../components/BooksContent.astro';
import { readPath, useTranslations } from '../i18n/utils';

const t = useTranslations('en');
---

<BaseLayout
  title={`${t('nav.books')} | madebygps`}
  description={t('books.description')}
  lang="en"
  altLangUrl={readPath('es')}
>
  <BooksContent lang="en" />
</BaseLayout>

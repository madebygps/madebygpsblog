---
import PostList from './PostList.astro';
import { getDisplayPosts } from '../i18n/posts';
import { blogPath, useTranslations, type Lang } from '../i18n/utils';

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = useTranslations(lang);
const posts = (await getDisplayPosts(lang)).slice(0, 4);
---

<section class="home-intro">
  <h1>{t('home.title')}</h1>
  <p class="lede">{t('home.intro')}</p>
</section>

<section aria-labelledby="recent-writing">
  <div class="section-heading">
    <h2 id="recent-writing">{t('home.recent')}</h2>
    <a href={blogPath(lang)}>{t('home.allWriting')} &rarr;</a>
  </div>
  <PostList lang={lang} posts={posts} groupByYear={false} showTags={false} />
</section>

<div class="home-resources">
  <section>
    <h2><a href="/read/">{t('nav.books')} &rarr;</a></h2>
    <p>{t('home.booksDescription')}</p>
  </section>
  <section>
    <h2><a href="https://learntocloud.guide">Learn to Cloud &rarr;</a></h2>
    <p>{t('home.cloudDescription')}</p>
  </section>
</div>

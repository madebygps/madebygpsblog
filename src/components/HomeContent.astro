---
import SocialLinks from './SocialLinks.astro';
import { useTranslations, type Lang } from '../i18n/utils';

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="home-profile" aria-labelledby="profile-title">
  <h1 id="profile-title" class="visually-hidden">{t('home.title')}</h1>
  <p class="profile-bio">{t('home.intro')}</p>
  <SocialLinks lang={lang} />
</section>

<section class="profile-updates" aria-label={t('home.lately')}>
  <dl>
    <div class="profile-row">
      <dt>{t('home.building')}</dt>
      <dd><a href="https://github.com/learntocloud/learn-to-cloud-app" target="_blank" rel="noopener noreferrer">Learn to Cloud <span aria-hidden="true">↗</span></a></dd>
    </div>
    <div class="profile-row">
      <dt>{t('home.writing')}</dt>
      <dd><a href="https://madebygps.substack.com/p/my-weekly-screen-time-is-41-minutes" lang="en" target="_blank" rel="noopener noreferrer">My weekly screen time average is 41 minutes <span aria-hidden="true">↗</span></a></dd>
    </div>
    <div class="profile-row">
      <dt>{t('home.reading')}</dt>
      <dd>Code {t('home.by')} Charles Petzold</dd>
    </div>
    <div class="profile-row">
      <dt>{t('home.sharing')}</dt>
      <dd><a href="https://www.youtube.com/watch?v=Cifpa5ZxYmM" lang="en" target="_blank" rel="noopener noreferrer">A great book to teach you the most important tech skill for the AI era <span aria-hidden="true">↗</span></a></dd>
    </div>
  </dl>
</section>

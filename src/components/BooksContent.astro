---
import { useTranslations, type Lang } from '../i18n/utils';

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = useTranslations(lang);

type Book = { title: string; author: string; href: string };

const shelves: { name: string; books: Book[] }[] = [
  {
    name: t('books.shelf.impact'),
    books: [
      { title: 'Recoding America', author: 'Jennifer Pahlka', href: 'https://www.recodingamerica.us/' },
      { title: 'The Coming Wave', author: 'Mustafa Suleyman', href: 'https://www.the-coming-wave.com/' },
      { title: 'Tools and Weapons', author: 'Brad Smith', href: 'https://www.penguinrandomhouse.com/books/604709/tools-and-weapons-by-brad-smith-and-carol-ann-browne/' },
      { title: 'Burn Book', author: 'Kara Swisher', href: 'https://www.pbsbooks.org/virtual-library/burn-book-a-tech-love-story/' },
    ],
  },
  {
    name: t('books.shelf.focus'),
    books: [
      { title: 'Digital Minimalism', author: 'Cal Newport', href: 'https://calnewport.com/my-new-book-digital-minimalism/' },
      { title: 'Stolen Focus', author: 'Johann Hari', href: 'https://stolenfocusbook.com/' },
    ],
  },
  {
    name: t('books.shelf.discipline'),
    books: [
      { title: 'Grit', author: 'Angela Duckworth', href: 'https://angeladuckworth.com/grit-book/' },
      { title: 'Discipline Is Destiny', author: 'Ryan Holiday', href: 'https://store.dailystoic.com/pages/discipline-is-destiny' },
    ],
  },
  {
    name: t('books.shelf.soul'),
    books: [
      { title: 'Stillness Is the Key', author: 'Ryan Holiday', href: 'https://dailystoic.com/stillness-is-the-key/' },
      { title: 'An Emotional Education', author: 'The School of Life', href: 'https://www.theschooloflife.com/shop/an-emotional-education/' },
      { title: 'Together', author: 'Vivek Murthy', href: 'https://www.vivekmurthy.com/together-book' },
      { title: 'The Daily Stoic', author: 'Ryan Holiday', href: 'https://www.goodreads.com/book/show/29093292-the-daily-stoic' },
      { title: 'All About Love', author: 'bell hooks', href: 'https://bellhooksbooks.com/product/all-about-love/' },
    ],
  },
  {
    name: t('books.shelf.worlds'),
    books: [
      { title: 'Stories of Your Life and Others', author: 'Ted Chiang', href: 'https://www.penguinrandomhouse.com/books/538163/stories-of-your-life-and-others-by-ted-chiang/' },
      { title: 'The Phoenix Project', author: 'Gene Kim', href: 'https://itrevolution.com/product/the-phoenix-project/' },
      { title: 'Exhalation', author: 'Ted Chiang', href: 'https://www.penguinrandomhouse.com/books/538034/exhalation-by-ted-chiang/' },
      { title: 'Babel', author: 'R. F. Kuang', href: 'https://www.harpercollins.com/products/babel-r-f-kuang?variant=39874690940962' },
      { title: 'Project Hail Mary', author: 'Andy Weir', href: 'https://www.penguinrandomhouse.com/books/611060/project-hail-mary-by-andy-weir/' },
      { title: 'The Mountain in the Sea', author: 'Ray Nayler', href: 'https://tombolobooks.com/item/3Czr8TaWU9-EJk7ukwhFFw' },
      { title: 'Demon Copperhead', author: 'Barbara Kingsolver', href: 'https://concordbookshop.com/book/9780063251984' },
    ],
  },
  {
    name: t('books.shelf.thinking'),
    books: [
      { title: 'What’s Our Problem?', author: 'Tim Urban', href: 'https://waitbutwhy.com/whatsourproblem' },
      { title: 'Why Fish Don’t Exist', author: 'Lulu Miller', href: 'https://www.simonandschuster.com/books/Why-Fish-Dont-Exist/Lulu-Miller/9781501160349' },
    ],
  },
  {
    name: t('books.shelf.physicalHealth'),
    books: [
      { title: 'Why We Sleep', author: 'Matthew Walker', href: 'https://www.simonandschuster.com/books/Why-We-Sleep/Matthew-Walker/9781501144325' },
      { title: 'The Body Keeps the Score', author: 'Bessel van der Kolk', href: 'https://www.besselvanderkolk.com/resources/the-body-keeps-the-score' },
    ],
  },
  {
    name: t('books.shelf.mentalHealth'),
    books: [
      { title: 'The Boy Who Was Raised as a Dog', author: 'Bruce D. Perry', href: 'https://www.hachettebookgroup.com/titles/bruce-d-perry/the-boy-who-was-raised-as-a-dog/9780465094455/?lens=basic-books' },
    ],
  },
  {
    name: t('books.shelf.finances'),
    books: [
      { title: 'I Will Teach You to Be Rich', author: 'Ramit Sethi', href: 'https://www.iwillteachyoutoberich.com/books/' },
    ],
  },
  {
    name: t('books.shelf.giants'),
    books: [
      { title: 'Personal History', author: 'Katharine Graham', href: 'https://www.penguinrandomhouse.com/books/70346/personal-history-by-katharine-graham/' },
      { title: 'Einstein', author: 'Walter Isaacson', href: 'https://www.simonandschuster.com/books/Einstein/Walter-Isaacson/9780743264747' },
      { title: 'Meditations', author: 'Marcus Aurelius', href: 'https://classics.mit.edu/Antoninus/meditations.html' },
      { title: 'Lives of the Stoics', author: 'Ryan Holiday', href: 'https://www.penguinrandomhouse.com/books/605841/lives-of-the-stoics-by-ryan-holiday-and-stephen-hanselman/' },
      { title: 'Leonardo da Vinci', author: 'Walter Isaacson', href: 'https://www.simonandschuster.com/books/Leonardo-da-Vinci/Walter-Isaacson/9781501139161' },
      { title: 'The Last Days of the Incas', author: 'Kim MacQuarrie', href: 'https://www.simonandschuster.com/books/The-Last-Days-of-the-Incas/Kim-MacQuarrie/9780743260503' },
    ],
  },
];

---

<section class="page-head">
  <h1>{t('nav.books')}</h1>
  <p class="profile-bio">{t('books.lede')}</p>
</section>

{
  shelves.map((shelf) => (
    <section class="book-group">
      <h2>{shelf.name}</h2>
      <ul class="book-list">
        {shelf.books.map((book) => (
          <li>
            <a href={book.href} target="_blank" rel="noopener noreferrer">{book.title}</a>
            {' '}<span class="book-author">{t('home.by')} {book.author}</span>
          </li>
        ))}
      </ul>
    </section>
  ))
}

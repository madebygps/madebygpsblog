---
import { tagSlug } from '../lib/tags';
import { blogPath, tagPath, useTranslations, type Lang } from '../i18n/utils';

type Props = {
  lang: Lang;
  tags: [string, number][];
};

const { lang, tags } = Astro.props;
const t = useTranslations(lang);
---

{
  tags.length > 0 && (
    <nav class="topic-filter" aria-label={t('blog.browseByTopic')}>
      <select aria-label={t('blog.browseByTopic')} data-topic-filter>
        <option value={blogPath(lang)}>{t('blog.allTopics')}</option>
        {tags.map(([tag]) => (
          <option value={tagPath(lang, tagSlug(tag))}>{tag}</option>
        ))}
      </select>
      <noscript>
        <div class="tag-cloud">
          {tags.map(([tag]) => (
            <a class="tag" href={tagPath(lang, tagSlug(tag))}>{tag}</a>
          ))}
        </div>
      </noscript>
    </nav>
  )
}

<script>
  document.querySelectorAll<HTMLSelectElement>('[data-topic-filter]').forEach((select) => {
    select.addEventListener('change', () => {
      window.location.assign(select.value);
    });
  });
</script>

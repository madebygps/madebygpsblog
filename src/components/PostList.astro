---
import { tagSlug } from '../lib/tags';
import { formatDate, postPath, tagPath, useTranslations, type Lang } from '../i18n/utils';
import { postSlug, type BlogPost } from '../i18n/posts';

type Props = {
  lang: Lang;
  posts: BlogPost[];
};

const { lang, posts } = Astro.props;
const t = useTranslations(lang);

const postsByYear = posts.reduce((groups, post) => {
  const year = post.data.pubDate.getFullYear().toString();
  const yearPosts = groups.get(year) ?? [];
  yearPosts.push(post);
  groups.set(year, yearPosts);
  return groups;
}, new Map<string, BlogPost[]>());
---

{
  posts.length > 0 ? (
    <div class="post-list" aria-label={t('blog.allPosts')}>
      {[...postsByYear.entries()].map(([year, yearPosts]) => (
        <section class="post-group" aria-labelledby={`year-${year}`}>
          <h2 id={`year-${year}`} class="year-label">
            {year}
            <span class="year-count">{yearPosts.length}</span>
          </h2>
          <ul class="post-files">
            {yearPosts.map((post) => (
              <li class="post-file">
                <a class="post-file-link" href={postPath(post.data.lang, postSlug(post))}>
                  <time class="post-date" datetime={post.data.pubDate.toISOString()}>
                    {formatDate(post.data.pubDate, lang)}
                  </time>
                  <span class="post-title">{post.data.title}</span>
                </a>
                <p class="post-summary">{post.data.description}</p>
                {post.data.tags.length > 0 && (
                  <div class="tags" aria-label={`${t('tag.tagsFor')} ${post.data.title}`}>
                    {post.data.tags.map((tag) => (
                      <a class="tag" href={tagPath(lang, tagSlug(tag))}>
                        {tag}
                      </a>
                    ))}
                  </div>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  ) : (
    <p class="empty-state">{t('blog.noPosts')}</p>
  )
}

---
import { useTranslations, type Lang, homePath, blogPath, aboutPath, readPath } from '../i18n/utils';
import { defaultLang } from '../i18n/ui';

type Props = {
  title: string;
  description?: string;
  lang?: Lang;
  altLangUrl?: string;
  wide?: boolean;
};

const { title, lang = defaultLang, wide = false } = Astro.props;
const t = useTranslations(lang);
const description = Astro.props.description ?? t('site.description');
const otherLang: Lang = lang === 'en' ? 'es' : 'en';
const altLangUrl = Astro.props.altLangUrl ?? homePath(otherLang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {
      Astro.site && (
        <>
          <link
            rel="alternate"
            hreflang={lang}
            href={new URL(Astro.url.pathname, Astro.site).href}
          />
          <link
            rel="alternate"
            hreflang={otherLang}
            href={new URL(altLangUrl, Astro.site).href}
          />
        </>
      )
    }
    <style is:global>
      :root {
        color-scheme: light;
        --background: #fdfcfb;
        --surface: #f1f1eb;
        --surface-muted: #e7e9e1;
        --text: #2d2e29;
        --muted: #72756c;
        --accent: #536747;
        --accent-strong: #37482e;
        --border: #e7e8e2;
        --measure: 35rem;
        --shell: 52rem;
        --reading: 35rem;
        --top-space: clamp(55px, 13vh, 135px);
        --sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        --serif: Georgia, "Times New Roman", serif;
        --mono: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        font-family: var(--sans);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scrollbar-gutter: stable;
      }

      body {
        background: var(--background);
        color: var(--text);
        display: flex;
        flex-direction: column;
        font-size: 0.875rem;
        line-height: 1.8;
        margin: 0;
        min-height: 100svh;
        padding: var(--top-space) 0 4rem;
      }

      a {
        color: inherit;
        text-decoration: none;
        text-decoration-thickness: 0.06em;
        text-underline-offset: 0.18em;
      }

      a:hover {
        text-decoration: underline;
      }

      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }

      .visually-hidden {
        clip-path: inset(50%);
        height: 1px;
        overflow: hidden;
        position: absolute;
        white-space: nowrap;
        width: 1px;
      }

      body > header,
      body > main,
      body > footer {
        margin-inline: auto;
        width: min(100% - 3rem, var(--measure));
      }

      body > main {
        margin-top: 2rem;
      }

      body > main.wide {
        width: min(100% - 2.5rem, var(--shell));
      }

      body > footer {
        align-items: baseline;
        color: var(--muted);
        display: flex;
        flex-wrap: wrap;
        font-size: 0.6875rem;
        gap: 1rem;
        justify-content: space-between;
        margin-top: 0;
        padding-top: 3.375rem;
      }

      .site-nav {
        align-items: center;
        display: flex;
        gap: 1.5rem;
        justify-content: space-between;
        min-height: 2.75rem;
      }

      .site-brand {
        align-items: center;
        color: var(--text);
        display: flex;
        flex-shrink: 0;
        font-size: 1.4375rem;
        font-weight: 600;
        gap: 0.875rem;
        letter-spacing: -0.04375rem;
        line-height: 1.3;
      }

      .site-brand:hover {
        text-decoration: none;
      }

      .site-avatar {
        background: var(--surface-muted);
        border-radius: 50%;
        height: 2.75rem;
        object-fit: cover;
        width: 2.75rem;
      }

      .nav-links,
      .lang-switch {
        align-items: baseline;
        display: flex;
      }

      .nav-links {
        gap: 1.3125rem;
      }

      .lang-switch {
        gap: 0.75rem;
      }

      .nav-links > a {
        color: var(--muted);
        font-size: 0.75rem;
      }

      .lang-switch span[aria-current] {
        color: var(--text);
      }

      .nav-links a[aria-current="page"] {
        color: var(--text);
        text-decoration: underline;
        text-decoration-color: var(--muted);
      }

      .site-nav a:hover,
      .site-nav a:focus-visible {
        color: var(--accent);
      }

      h1,
      h2,
      h3 {
        line-height: 1.2;
      }

      h1 {
        font-size: 1.4375rem;
        font-weight: 600;
        letter-spacing: -0.04375rem;
        margin: 0;
      }

      h2 {
        font-size: 1.3rem;
        font-weight: 700;
        margin: 2.5rem 0 0.75rem;
      }

      h3 {
        font-size: 1.1rem;
        font-weight: 700;
        margin: 2rem 0 0.5rem;
      }

      p {
        margin: 0 0 1.25rem;
      }

      .eyebrow {
        color: var(--muted);
        font-size: 0.8rem;
        margin: 0 0 0.75rem;
      }

      .lede {
        color: var(--muted);
        font-size: 1.1rem;
        margin: 1rem 0 0;
      }

      .page-head {
        margin: 0 0 2.125rem;
        text-align: left;
      }

      .archive-head {
        align-items: baseline;
        display: flex;
        gap: 1.5rem;
        justify-content: space-between;
      }

      .page-body {
        color: var(--text);
        font-size: 0.875rem;
        line-height: 2;
      }

      .page-body a {
        text-decoration: underline;
        text-decoration-color: var(--muted);
      }

      .page-head .lede {
        max-width: 38rem;
      }

      .page-body p:last-child,
      .page-section p:last-child {
        margin-bottom: 0;
      }

      .page-section {
        margin-top: 2.5rem;
      }

      .page-section h2 {
        margin-top: 0;
      }

      .tag-cloud {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem 1.25rem;
        justify-content: flex-start;
        margin: 1.25rem 0 0;
      }

      .topic-filter select {
        background: var(--background);
        border: 0;
        color: var(--muted);
        cursor: pointer;
        font: 0.6875rem var(--sans);
        max-width: 9rem;
        padding: 0.3125rem 0 0.3125rem 0.4375rem;
      }

      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem 1rem;
        margin: 0.85rem 0 0;
      }

      .tag {
        color: var(--muted);
        font-size: 0.8rem;
        text-decoration: none;
      }

      .tag::before {
        content: "#";
      }

      .tag:hover,
      .tag:focus-visible {
        color: var(--accent);
      }

      .tag span {
        margin-left: 0.3rem;
      }

      .post-group {
        column-gap: 1.4375rem;
        display: grid;
        grid-template-columns: 4.125rem minmax(0, 1fr);
      }

      .post-group + .post-group {
        margin-top: 1.6875rem;
      }

      .year-label {
        color: var(--muted);
        font-size: 0.75rem;
        font-weight: 400;
        line-height: 1.8;
        margin: 0;
        padding-top: 0.5rem;
        text-align: left;
      }

      .post-files {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .post-file {
        padding: 0.5rem 0;
      }

      .post-file-link {
        color: var(--text);
        display: block;
        text-decoration: none;
      }

      .post-title {
        display: block;
        font-size: 0.875rem;
        font-weight: 400;
        line-height: 1.8;
      }

      .post-file-link:hover .post-title,
      .post-file-link:focus-visible .post-title {
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: 0.18em;
      }

      .empty-state {
        color: var(--muted);
        font-size: 0.95rem;
      }

      .post-meta {
        color: var(--muted);
        font-family: var(--sans);
        font-size: 0.8rem;
        margin: 0 0 0.75rem;
      }

      .post-meta a {
        color: var(--muted);
      }

      .post-article {
        font-family: var(--serif);
        font-size: 1.125rem;
        line-height: 1.8;
        margin-inline: auto;
        max-width: var(--reading);
      }

      .post-article h1,
      .post-article h2,
      .post-article h3,
      .post-article .lede {
        font-family: var(--sans);
      }

      .post-article .lede {
        margin-top: 1rem;
      }

      .post-article h1 {
        font-size: clamp(1.5rem, 4vw, 2rem);
        line-height: 1.3;
      }

      .post-article a {
        color: var(--accent);
        text-decoration: underline;
      }

      .post-article .tag {
        text-decoration: none;
      }

      .profile-bio {
        color: var(--muted);
        font-size: 0.8125rem;
        margin: 0;
      }

      .social-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 0.75rem;
      }

      .social-links a {
        align-items: center;
        color: var(--muted);
        display: flex;
        height: 1.75rem;
        justify-content: center;
        width: 1.5rem;
      }

      .social-links a:hover,
      .social-links a:focus-visible {
        color: var(--text);
      }

      .social-links svg {
        height: 1.0625rem;
        width: 1.0625rem;
      }

      .profile-updates {
        border-top: 1px solid var(--border);
        margin-top: 2.3125rem;
        padding-top: 1.25rem;
      }

      .profile-updates dl {
        margin: 0;
      }

      .profile-row {
        align-items: baseline;
        column-gap: 1.4375rem;
        display: grid;
        grid-template-columns: 4.125rem minmax(0, 1fr);
        padding: 0.8125rem 0;
      }

      .profile-row dt {
        color: var(--muted);
        font-size: 0.75rem;
      }

      .profile-row dd {
        font-size: 0.875rem;
        margin: 0;
      }

      article pre {
        background: var(--surface);
        border: 1px solid var(--border);
        font-size: 0.85rem;
        line-height: 1.6;
        margin: 1.75rem 0;
        overflow-x: auto;
        padding: 1rem 1.1rem;
      }

      /* Shiki sets the theme background inline; seat it on the page surface instead. */
      article pre.astro-code {
        background: var(--surface) !important;
      }

      article code {
        font-family: var(--mono);
        font-size: 0.9em;
      }

      article blockquote {
        border-left: 1px solid var(--border);
        color: var(--muted);
        font-style: italic;
        margin: 1.75rem 0;
        padding-left: 1.25rem;
      }

      article ul,
      article ol {
        margin: 0 0 1.25rem;
        padding-left: 1.25rem;
      }

      article li {
        margin-bottom: 0.4rem;
      }

      article hr {
        border: 0;
        border-top: 1px solid var(--border);
        margin: 2.5rem 0;
      }

      article table {
        border-collapse: collapse;
        display: block;
        font-size: 0.92rem;
        margin: 2rem 0;
        overflow-x: auto;
        width: 100%;
      }

      article thead th {
        border-bottom: 1px solid var(--text);
        border-top: 1px solid var(--text);
      }

      article th,
      article td {
        border-bottom: 1px solid var(--border);
        padding: 0.5rem 1rem 0.5rem 0;
        text-align: left;
      }

      article figure {
        margin: 2rem 0;
      }

      article figcaption {
        color: var(--muted);
        font-family: var(--mono);
        font-size: 0.72rem;
        margin-top: 0.6rem;
        text-align: center;
      }

      article img {
        display: block;
        height: auto;
        margin-inline: auto;
        max-height: min(62vh, 520px);
        max-width: 100%;
        width: auto;
      }

      article iframe {
        aspect-ratio: 16 / 9;
        border: 0;
        height: auto;
        max-width: 100%;
        width: 100%;
      }

      .feature-image {
        display: block;
        margin: 0 0 2.5rem;
        max-height: 22rem;
        object-fit: cover;
        width: 100%;
      }

      article .tags {
        font-family: var(--sans);
        margin-top: 2rem;
      }

      .book-group + .book-group {
        margin-top: 2rem;
      }

      .book-group h2 {
        color: var(--muted);
        font-size: 0.75rem;
        font-weight: 400;
        margin: 0 0 0.5rem;
      }

      .book-list {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .book-list li {
        padding: 0.375rem 0;
      }

      .book-author {
        color: var(--muted);
        font-size: 0.75rem;
      }

      @media (max-width: 480px) {
        :root {
          --top-space: 55px;
        }

        .site-nav {
          gap: 0.75rem;
        }

        body > header,
        body > main,
        body > footer {
          width: calc(100% - 2.75rem);
        }

        .nav-links {
          gap: 1rem;
        }

        .post-group,
        .profile-row {
          column-gap: 1.0625rem;
          grid-template-columns: 3.5rem minmax(0, 1fr);
        }

        .post-title,
        .profile-row dd,
        .page-body {
          font-size: 0.8125rem;
        }

        .profile-bio {
          font-size: 0.75rem;
        }
      }
    </style>
    <script is:inline>
      document.addEventListener(
        'error',
        (event) => {
          const target = event.target;

          if (!(target instanceof HTMLImageElement)) {
            return;
          }

          const figure = target.closest('figure');

          if (figure) {
            figure.remove();
            return;
          }

          target.remove();
        },
        true
      );
    </script>
  </head>
  <body>
    <header>
      <nav class="site-nav" aria-label={t('nav.main')}>
        <a class="site-brand" href={homePath(lang)} aria-label={`GPS · ${t('nav.home')}`}>
          <img class="site-avatar" src="/images/gps.jpg" alt="" width="44" height="44" />
          <span>GPS</span>
        </a>
        <div class="nav-links">
          <a href={blogPath(lang)} aria-current={Astro.url.pathname.startsWith(blogPath(lang)) ? 'page' : undefined}>{t('nav.blog')}</a>
          <a href={readPath(lang)} aria-current={Astro.url.pathname.replace(/\/$/, '') === readPath(lang).replace(/\/$/, '') ? 'page' : undefined}>{t('nav.books')}</a>
          <a href={aboutPath(lang)} aria-current={Astro.url.pathname.replace(/\/$/, '') === aboutPath(lang).replace(/\/$/, '') ? 'page' : undefined}>{t('nav.about')}</a>
        </div>
      </nav>
    </header>
    <main class:list={{ wide }}>
      <slot />
    </main>
    <footer>
      <a href="https://github.com/madebygps/madebygpsblog" target="_blank" rel="noopener noreferrer">{t('footer.builtWith')}</a>
      <div class="lang-switch" aria-label={t('lang.label')}>
        {lang === 'en' ? <span aria-current="true">EN</span> : <a href={altLangUrl}>EN</a>}
        {lang === 'es' ? <span aria-current="true">ES</span> : <a href={altLangUrl}>ES</a>}
      </div>
    </footer>
  </body>
</html>

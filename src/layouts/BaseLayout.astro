---
import { useTranslations, type Lang, homePath, blogPath, aboutPath } from '../i18n/utils';
import { defaultLang } from '../i18n/ui';

type Props = {
  title: string;
  description?: string;
  lang?: Lang;
  altLangUrl?: string;
};

const { title, lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const description = Astro.props.description ?? t('site.description');
const otherLang: Lang = lang === 'en' ? 'es' : 'en';
const altLangUrl = Astro.props.altLangUrl ?? homePath(otherLang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {
      Astro.site && (
        <>
          <link
            rel="alternate"
            hreflang={lang}
            href={new URL(Astro.url.pathname, Astro.site).href}
          />
          <link
            rel="alternate"
            hreflang={otherLang}
            href={new URL(altLangUrl, Astro.site).href}
          />
        </>
      )
    }
    <style is:global>
      :root {
        color-scheme: light;
        --background: #e9e6de;
        --surface: #f4f2ea;
        --surface-muted: #dedbd1;
        --text: #1d1c19;
        --muted: #5f5c54;
        --accent: #7b3028;
        --accent-strong: #5e231e;
        --border: #bab6ab;
        --measure: 40rem;
        --mono: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        font-family: Georgia, "Times New Roman", serif;
      }

      * {
        box-sizing: border-box;
      }

      body {
        background: var(--background);
        color: var(--text);
        font-size: 1.0625rem;
        line-height: 1.7;
        margin: 0;
      }

      a {
        color: var(--accent);
        text-decoration-thickness: 0.06em;
        text-underline-offset: 0.18em;
      }

      a:hover {
        color: var(--accent-strong);
      }

      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }

      .visually-hidden {
        clip-path: inset(50%);
        height: 1px;
        overflow: hidden;
        position: absolute;
        white-space: nowrap;
        width: 1px;
      }

      body > header,
      body > main,
      body > footer {
        margin-inline: auto;
        width: min(100% - 2.5rem, var(--measure));
      }

      body > header {
        padding: 2.25rem 0 0;
      }

      body > main {
        padding: 3.5rem 0 5rem;
      }

      body > footer {
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 0.85rem;
        padding: 1.5rem 0 3rem;
      }

      .site-nav {
        align-items: baseline;
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
      }

      .site-nav > a {
        color: var(--text);
        font-family: var(--mono);
        font-size: 0.8rem;
        letter-spacing: 0.16em;
        text-decoration: none;
        text-transform: uppercase;
      }

      .nav-links,
      .social-links,
      .lang-switch {
        align-items: baseline;
        display: flex;
        gap: 1rem;
      }

      .nav-links {
        flex-wrap: wrap;
        margin-left: auto;
      }

      .nav-links a,
      .lang-switch span[aria-current] {
        font-family: var(--mono);
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-decoration: none;
        text-transform: uppercase;
      }

      .nav-links > a {
        color: var(--text);
      }

      .social-links a,
      .lang-switch a {
        color: var(--muted);
      }

      .lang-switch span[aria-current] {
        color: var(--text);
      }

      .site-nav a:hover,
      .site-nav a:focus-visible {
        color: var(--accent);
      }

      h1,
      h2,
      h3 {
        line-height: 1.2;
      }

      h1 {
        font-size: clamp(2rem, 5vw, 2.75rem);
        font-weight: 400;
        letter-spacing: -0.01em;
        margin: 0;
      }

      h2 {
        font-size: 1.3rem;
        font-weight: 700;
        margin: 2.5rem 0 0.75rem;
      }

      h3 {
        font-size: 1.1rem;
        font-weight: 700;
        margin: 2rem 0 0.5rem;
      }

      p {
        margin: 0 0 1.25rem;
      }

      .eyebrow {
        color: var(--muted);
        font-family: var(--mono);
        font-size: 0.72rem;
        letter-spacing: 0.18em;
        margin: 0 0 1.25rem;
        text-transform: uppercase;
      }

      .lede {
        color: var(--muted);
        font-size: 1.1rem;
        margin: 1rem 0 0;
      }

      .page-head {
        border-bottom: 1px solid var(--border);
        margin: 0 0 3rem;
        padding: 0 0 2.5rem;
        text-align: center;
      }

      .page-head .lede {
        margin-inline: auto;
        max-width: 34rem;
      }

      .page-body p:last-child,
      .page-section p:last-child {
        margin-bottom: 0;
      }

      .page-section {
        border-top: 1px solid var(--border);
        margin-top: 3rem;
        padding-top: 2.5rem;
      }

      .page-section h2 {
        margin-top: 0;
      }

      .tag-cloud {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem 1.25rem;
        justify-content: center;
        margin: 1.75rem 0 0;
      }

      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem 1rem;
        margin: 0.85rem 0 0;
      }

      .tag {
        color: var(--muted);
        font-family: var(--mono);
        font-size: 0.72rem;
        letter-spacing: 0.06em;
        text-decoration: none;
      }

      .tag::before {
        content: "#";
      }

      .tag:hover,
      .tag:focus-visible {
        color: var(--accent);
      }

      .tag span {
        margin-left: 0.3rem;
      }

      .post-group + .post-group {
        margin-top: 3.5rem;
      }

      .year-label {
        border-bottom: 1px solid var(--border);
        color: var(--text);
        font-family: var(--mono);
        font-size: 0.75rem;
        font-weight: 400;
        letter-spacing: 0.22em;
        margin: 0;
        padding: 0 0 0.85rem;
        text-align: center;
      }

      .year-count {
        color: var(--muted);
        margin-left: 0.6rem;
      }

      .post-files {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .post-file {
        border-bottom: 1px solid var(--border);
        padding: 1.75rem 0;
      }

      .post-file-link {
        color: var(--text);
        display: block;
        text-decoration: none;
      }

      .post-date {
        color: var(--muted);
        display: block;
        font-family: var(--mono);
        font-size: 0.72rem;
        letter-spacing: 0.1em;
        margin: 0 0 0.5rem;
        text-transform: uppercase;
      }

      .post-title {
        display: block;
        font-size: 1.25rem;
        line-height: 1.35;
      }

      .post-file-link:hover .post-title,
      .post-file-link:focus-visible .post-title {
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: 0.18em;
      }

      .post-summary {
        color: var(--muted);
        font-size: 0.98rem;
        margin: 0.6rem 0 0;
      }

      .empty-state {
        color: var(--muted);
        font-family: var(--mono);
        font-size: 0.85rem;
        text-align: center;
      }

      .post-meta {
        color: var(--muted);
        font-family: var(--mono);
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        margin: 0 0 0.75rem;
        text-transform: uppercase;
      }

      .post-meta a {
        color: var(--muted);
      }

      article .lede {
        margin-top: 1.25rem;
      }

      article pre {
        background: var(--surface);
        border: 1px solid var(--border);
        font-size: 0.85rem;
        line-height: 1.6;
        margin: 1.75rem 0;
        overflow-x: auto;
        padding: 1rem 1.1rem;
      }

      /* Shiki sets the theme background inline; seat it on the page surface instead. */
      article pre.astro-code {
        background: var(--surface) !important;
      }

      article code {
        font-family: var(--mono);
        font-size: 0.9em;
      }

      article blockquote {
        border-left: 1px solid var(--border);
        color: var(--muted);
        font-style: italic;
        margin: 1.75rem 0;
        padding-left: 1.25rem;
      }

      article ul,
      article ol {
        margin: 0 0 1.25rem;
        padding-left: 1.25rem;
      }

      article li {
        margin-bottom: 0.4rem;
      }

      article hr {
        border: 0;
        border-top: 1px solid var(--border);
        margin: 2.5rem 0;
      }

      article table {
        border-collapse: collapse;
        display: block;
        font-size: 0.92rem;
        margin: 2rem 0;
        overflow-x: auto;
        width: 100%;
      }

      article thead th {
        border-bottom: 1px solid var(--text);
        border-top: 1px solid var(--text);
      }

      article th,
      article td {
        border-bottom: 1px solid var(--border);
        padding: 0.5rem 1rem 0.5rem 0;
        text-align: left;
      }

      article figure {
        margin: 2rem 0;
      }

      article figcaption {
        color: var(--muted);
        font-family: var(--mono);
        font-size: 0.72rem;
        margin-top: 0.6rem;
        text-align: center;
      }

      article img {
        display: block;
        height: auto;
        margin-inline: auto;
        max-height: min(62vh, 520px);
        max-width: 100%;
        width: auto;
      }

      article iframe {
        aspect-ratio: 16 / 9;
        border: 0;
        height: auto;
        max-width: 100%;
        width: 100%;
      }

      .feature-image {
        display: block;
        margin: 0 0 2.5rem;
        max-height: 22rem;
        object-fit: cover;
        width: 100%;
      }

      article .tags {
        border-top: 1px solid var(--border);
        justify-content: center;
        margin-top: 3rem;
        padding-top: 1.5rem;
      }

      @media (max-width: 640px) {
        body > header {
          padding-top: 1.5rem;
        }

        body > main {
          padding: 2.5rem 0 3.5rem;
        }

        .site-nav {
          gap: 0.9rem;
        }

        .nav-links {
          gap: 0.9rem;
          margin-left: 0;
        }

        .page-head {
          margin-bottom: 2.25rem;
          padding-bottom: 2rem;
        }
      }
    </style>
    <script is:inline>
      document.addEventListener(
        'error',
        (event) => {
          const target = event.target;

          if (!(target instanceof HTMLImageElement)) {
            return;
          }

          const figure = target.closest('figure');

          if (figure) {
            figure.remove();
            return;
          }

          target.remove();
        },
        true
      );
    </script>
  </head>
  <body>
    <header>
      <nav class="site-nav" aria-label={t('nav.main')}>
        <a href={homePath(lang)}>madebygps</a>
        <div class="nav-links">
          <a href={blogPath(lang)}>{t('nav.blog')}</a>
          <a href={aboutPath(lang)}>{t('nav.about')}</a>
          <div class="social-links" aria-label={t('nav.social')}>
            <a href="https://x.com/madebygps" target="_blank" rel="me noopener noreferrer">X</a>
            <a href="https://www.linkedin.com/in/madebygps" target="_blank" rel="me noopener noreferrer">LinkedIn</a>
            <a href="https://www.youtube.com/madebygps" target="_blank" rel="me noopener noreferrer">YouTube</a>
          </div>
          <div class="lang-switch" aria-label={t('lang.label')}>
            {lang === 'en' ? <span aria-current="true">EN</span> : <a href={altLangUrl}>EN</a>}
            {lang === 'es' ? <span aria-current="true">ES</span> : <a href={altLangUrl}>ES</a>}
          </div>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <small>{t('footer.builtWith')}</small>
    </footer>
  </body>
</html>

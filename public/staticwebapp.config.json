{
  "routes": [
    { "route": "/links", "redirect": "/", "statusCode": 301 },
    { "route": "/links/", "redirect": "/", "statusCode": 301 }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY"
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  }
}
